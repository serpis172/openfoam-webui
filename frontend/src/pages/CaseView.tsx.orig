import { useQuery } from '@tanstack/react-query'
import {
  Activity,
  AlertTriangle,
  Play,
  RefreshCw,
  Square,
} from 'lucide-react'
import { useEffect, useState } from 'react'
import { useParams } from 'react-router-dom'
import { api, CaseResponse, JobStatusResponse, ResidualsResponse, ValidationResponse, ReportResponse, LogsResponse } from '../api'
import FileBrowser from '../components/FileBrowser'
import ResidualsChart from '../components/ResidualsChart'
import StatusBadge from '../components/StatusBadge'
import ViewerFrame from '../components/ViewerFrame'

const tabs = [
  'Panoramica',
  'File',
  'Validazione',
  'Esecuzione',
  'Residui',
  'Report',
  'Viewer 3D',
]

export default function CaseView() {
  const { caseId } = useParams<{ caseId: string }>()
  const [tab, setTab] = useState('Panoramica')
  const [jobId, setJobId] = useState<string | null>(null)

  const caseQuery = useQuery<CaseResponse>({
    queryKey: ['case', caseId],
    queryFn: () => api.getCase(caseId!),
    enabled: !!caseId,
  })

  const jobQuery = useQuery<JobStatusResponse>({
    queryKey: ['job', jobId],
    queryFn: () => api.jobStatus(jobId!),
    enabled: !!jobId,
    refetchInterval: 2000,
  })

  const residualsQuery = useQuery<ResidualsResponse>({
    queryKey: ['residuals', caseId],
    queryFn: () => api.residuals(caseId!),
    enabled: !!caseId && tab === 'Residui',
    refetchInterval: 3000,
  })

  const validationQuery = useQuery<ValidationResponse>({
    queryKey: ['validation', caseId],
    queryFn: () => api.validate(caseId!),
    enabled: !!caseId && tab === 'Validazione',
  })

  const reportQuery = useQuery<ReportResponse>({
    queryKey: ['report', caseId],
    queryFn: () => api.report(caseId!),
    enabled: !!caseId && tab === 'Report',
  })

  const logsQuery = useQuery<LogsResponse>({
    queryKey: ['logs', caseId],
    queryFn: () => api.logs(caseId!),
    enabled: !!caseId && tab === 'Esecuzione',
    refetchInterval: 3000,
  })

  const meta = caseQuery.data?.meta
  const config = caseQuery.data?.config
  const jobState = jobQuery.data?.state || 'UNKNOWN'
  const jobStep = jobQuery.data?.info?.step || '-'

  useEffect(() => {
    if (meta?.last_job_id && !jobId) {
      setJobId(meta.last_job_id)
    }
  }, [meta, jobId])

  const runCase = async () => {
    if (!caseId) return

    const response = await api.runCase(caseId, config?.mesh?.processors)
    setJobId(response.job_id)
    setTab('Esecuzione')
  }

  const cancelJob = async () => {
    if (!jobId) return
    await api.cancelJob(jobId)
  }

  return (
    <div>
      <div className="flex items-center justify-between mb-8">
        <div>
          <h1 className="text-3xl font-bold">{meta?.name || caseId}</h1>
          <p className="text-slate-500 mt-1">{meta?.description}</p>
        </div>

        <div className="flex items-center gap-3">
          <StatusBadge state={jobState} />

          <button className="btn-primary flex items-center gap-2" onClick={runCase}>
            <Play className="w-4 h-4" />
            Avvia
          </button>

          {jobId && (
            <button className="btn-secondary flex items-center gap-2" onClick={cancelJob}>
              <Square className="w-4 h-4" />
              Annulla
            </button>
          )}
        </div>
      </div>

      <div className="card p-4 mb-6">
        <div className="flex gap-2 overflow-x-auto">
          {tabs.map(t => (
            <button
              key={t}
              className={`px-4 py-2 rounded-lg whitespace-nowrap ${
                tab === t
                  ? 'bg-blue-600 text-white'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
              onClick={() => setTab(t)}
            >
              {t}
            </button>
          ))}
        </div>
      </div>

      {tab === 'Panoramica' && (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div className="card p-6">
            <h3 className="font-semibold mb-4">Informazioni</h3>
            <div className="space-y-2 text-sm">
              <div><strong>ID:</strong> {meta?.id}</div>
              <div><strong>Solver:</strong> {meta?.solver}</div>
              <div><strong>Creato:</strong> {meta?.created_at}</div>
              <div><strong>Aggiornato:</strong> {meta?.updated_at}</div>
            </div>
          </div>

          <div className="card p-6">
            <h3 className="font-semibold mb-4">Fisica</h3>
            <div className="space-y-2 text-sm">
              <div><strong>Fluido:</strong> {config?.physics?.fluid}</div>
              <div><strong>Turbolenza:</strong> {config?.physics?.laminar ? 'laminar' : config?.physics?.turbulence}</div>
              <div><strong>End time:</strong> {config?.physics?.end_time}</div>
              <div><strong>Write interval:</strong> {config?.physics?.write_interval}</div>
            </div>
          </div>

          <div className="card p-6">
            <h3 className="font-semibold mb-4">Mesh</h3>
            <div className="space-y-2 text-sm">
              <div><strong>Tipo:</strong> {config?.mesh?.mesh_type}</div>
              <div><strong>Processori:</strong> {config?.mesh?.processors}</div>
              <div><strong>STL:</strong> {config?.mesh?.stl_file || 'nessuno'}</div>
              <div><strong>Layers:</strong> {config?.mesh?.layers}</div>
            </div>
          </div>
        </div>
      )}

      {tab === 'File' && caseId && <FileBrowser caseId={caseId} />}

      {tab === 'Validazione' && (
        <div className="card p-6">
          <h3 className="font-semibold mb-4 flex items-center gap-2">
            <AlertTriangle className="w-5 h-5" />
            Validazione caso
          </h3>

          {validationQuery.isLoading && <div>Validazione in corso...</div>}

          {validationQuery.data && (
            <div className="space-y-4">
              <div
                className={`p-4 rounded-xl ${
                  validationQuery.data.valid
                    ? 'bg-green-50 text-green-800'
                    : 'bg-red-50 text-red-800'
                }`}
              >
                {validationQuery.data.valid
                  ? 'Il caso è valido.'
                  : 'Il caso contiene errori.'}
              </div>

              {validationQuery.data.errors.length > 0 && (
                <div>
                  <h4 className="font-semibold mb-2">Errori</h4>
                  <ul className="list-disc pl-5 space-y-1 text-red-700">
                    {validationQuery.data.errors.map((err: string, i: number) => (
                      <li key={i}>{err}</li>
                    ))}
                  </ul>
                </div>
              )}

              {validationQuery.data.warnings.length > 0 && (
                <div>
                  <h4 className="font-semibold mb-2">Avvisi</h4>
                  <ul className="list-disc pl-5 space-y-1 text-amber-700">
                    {validationQuery.data.warnings.map((warn: string, i: number) => (
                      <li key={i}>{warn}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
        </div>
      )}

      {tab === 'Esecuzione' && (
        <div className="card p-6">
          <h3 className="font-semibold mb-4 flex items-center gap-2">
            <Activity className="w-5 h-5" />
            Esecuzione
          </h3>

          <div className="mb-4">
            <div className="text-sm text-slate-600">
              Stato: <strong>{jobState}</strong>
            </div>
            <div className="text-sm text-slate-600">
              Step corrente: <strong>{jobStep}</strong>
            </div>
          </div>

          <div className="space-y-4">
            {logsQuery.data?.logs?.map((log) => (
              <div key={log.name} className="border rounded-lg p-4">
                <div className="font-mono text-sm mb-2">{log.name}</div>
                <a
                  className="text-blue-600 text-sm"
                  href={`/api/files/${caseId}/download/${log.name}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  Scarica log
                </a>
              </div>
            ))}
          </div>
        </div>
      )}

      {tab === 'Residui' && (
        <div className="card p-6">
          <div className="flex items-center justify-between mb-4">
            <h3 className="font-semibold">Residui</h3>
            <button className="btn-secondary flex items-center gap-2" onClick={() => residualsQuery.refetch()}>
              <RefreshCw className="w-4 h-4" />
              Aggiorna
            </button>
          </div>

          <ResidualsChart residuals={residualsQuery.data?.residuals || {}} />
        </div>
      )}

      {tab === 'Report' && (
        <div className="card p-6">
          <h3 className="font-semibold mb-4">Report simulazione</h3>

          {reportQuery.data?.report ? (
            <pre className="bg-slate-900 text-green-300 p-4 rounded-xl overflow-auto text-sm">
              {JSON.stringify(reportQuery.data.report, null, 2)}
            </pre>
          ) : (
            <div className="text-slate-500">
              Nessun report disponibile. Esegui una simulazione.
            </div>
          )}
        </div>
      )}

      {tab === 'Viewer 3D' && caseId && <ViewerFrame caseId={caseId} />}
    </div>
  )
}