# Redis
REDIS_PASSWORD=cambia-questa-password
REDIS_URL=redis://:cambia-questa-password@redis:6379/0

# Storage
DATA_ROOT=/data
CASE_ROOT=/data/cases

# OpenFOAM
OPENFOAM_BASHRC=/opt/openfoam2406/etc/bashrc
DEFAULT_PROCESSORS=4

# Limiti
MAX_UPLOAD_MB=2048
MAX_CASES=100
JOB_TIMEOUT_SECONDS=86400

# Sicurezza
ENABLE_TERMINAL=false
CORS_ORIGINS=*
ALLOWED_GEOMETRY_EXTENSIONS=.stl,.obj,.vtk,.vtp

# Viewer
VIZ_PORT=8081