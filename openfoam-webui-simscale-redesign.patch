+    setLoading(true)
+    setError(null)
+
+    if (ctx.mesh) {
+      ctx.scene.remove(ctx.mesh)
+      ctx.mesh = null
+    }
+
+    const fitCameraTo = (object: THREE.Object3D) => {
+      const box = new THREE.Box3().setFromObject(object)
